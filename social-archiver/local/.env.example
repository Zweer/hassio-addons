# Local (self-hosted) environment overrides. Copy to .env (gitignored).
#
# NOTE: SA_BYPARR_URL, SA_OUTPUT_DIR, SA_INSTAGRAM_ACCOUNTS_FILE and
# SA_PINTEREST_QUERIES_FILE are set in docker-compose.yml — do NOT put them here.

# Discord webhook for run summaries (optional).
# SA_DISCORD_WEBHOOK_URL=

# Delay between requests/downloads, to be gentle on the source (ms).
SA_REQUEST_DELAY_MS=1500

# Send a Discord message even when nothing new was found.
SA_NOTIFY_EMPTY=false

# Max size of a single media download, in MB (optional; client default otherwise).
# SA_MAX_DOWNLOAD_MB=

# ─── Pinterest traversal ─────────────────────────────────────────────────────
# Depth is 1-based: 1 = only the seed queries in queries.txt; 2 = seeds + one
# level of related searches; 3 = seeds + related + related-of-related. depth=0
# is a config ERROR (it does NOT mean unlimited).
SA_PINTEREST_DEPTH=1

# Max pins archived per query.
SA_PINTEREST_MAX_IMAGES=50

# Hard cap on the TOTAL number of queries visited per run (REQUIRED whenever
# queries.txt is non-empty). When hit, the run stops cleanly.
SA_PINTEREST_MAX_QUERIES=20

# Max time (ms) Byparr may spend on a single Cloudflare solve. The stealth
# browser's FIRST (cold) solve can take 2-3 min when the host is under load,
# which is longer than the client's 60s default — raise it so a cold solve does
# not time out. 180000 (180s) keeps a fresh `cp .env.example .env` robust.
SA_BYPARR_TIMEOUT_MS=180000

# Host path bound into the archiver as /archive. Point this at the OS-level
# Samba mount of the Pi's /share (e.g. /mnt/pi-share/social-archiver) to write
# the archive straight to the Pi. Defaults to ./archive next to this file.
SA_HOST_OUTPUT=./archive
