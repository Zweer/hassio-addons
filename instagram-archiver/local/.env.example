# Local (self-hosted) environment overrides. Copy to .env (gitignored).
#
# NOTE: IA_BYPARR_URL, IA_OUTPUT_DIR and IA_ACCOUNTS_FILE are set in
# docker-compose.yml — do NOT put them here.

# Discord webhook for run summaries (optional).
# IA_DISCORD_WEBHOOK_URL=

# Delay between requests/downloads, to be gentle on the source (ms).
IA_REQUEST_DELAY_MS=1500

# Send a Discord message even when nothing new was found.
IA_NOTIFY_EMPTY=false

# Max size of a single media download, in MB (optional; client default otherwise).
# IA_MAX_DOWNLOAD_MB=

# Host path bound into the archiver as /archive. Point this at the OS-level
# Samba mount of the Pi's /share (e.g. /mnt/pi-share/instagram) to write the
# archive straight to the Pi. Defaults to ./archive next to this file.
IA_HOST_OUTPUT=./archive
