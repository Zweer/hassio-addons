# Local run configuration (used when /data/options.json is absent).
# Copy to .env and adjust.

# Comma-separated usernames (or a JSON array like ["nasa","natgeo"]).
IA_ACCOUNTS=nasa,natgeo

# Optional Discord webhook for the run summary.
# IA_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# Delay between requests/downloads (ms).
IA_REQUEST_DELAY_MS=1500

# Send a Discord message even when nothing new was found.
IA_NOTIFY_EMPTY=false

# Output directory (defaults to /share/instagram on Hassio).
IA_OUTPUT_DIR=./archive

# Optional per-file download cap (MB).
# IA_MAX_DOWNLOAD_MB=100
